[sub_resource type="Resource" id="Resource_yci7r"]
script = ExtResource("3_bmk4v")
entries = Array[ExtResource("1_eem42")]([SubResource("Resource_8uuqd")])
name = "NESTED"

[sub_resource type="Resource" id="Resource_elpgm"]
script = ExtResource("3_bmk4v")
entries = Array[ExtResource("1_eem42")]([SubResource("Resource_orgga"), SubResource("Resource_yci7r")])
name = "EXAMPLE_FOLDER"

[sub_resource type="Resource" id="Resource_8cjun"]
script = ExtResource("3_bmk4v")
name = "EMPTY_FOLDER"

[resource]
script = ExtResource("4_tic6n")
title = "DATA 09 // NODE CONSOLE"
entries = Array[ExtResource("1_eem42")]([SubResource("Resource_ihdx2"), SubResource("Resource_elpgm"), SubResource("Resource_8cjun")])
name = "DATA09"

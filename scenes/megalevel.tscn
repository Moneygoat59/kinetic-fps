[node name="CitadelTerminal" parent="Terminals" instance=ExtResource("7_terminal")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -6, 1, 20)
terminal_title = "SECTOR 00 // CITADEL CORE ARCHIVES"
log_content = "FACILITY CLASSIFICATION: SECTOR-00 PROVING GROUNDS\n--------------------------------------------------\nColossal kinetic testing biome spanning 600 meters.\n\nTRAVERSAL ADVISORY:\n- Jump into the central spire shaft to trigger the 52 m/s Hyper-Lift to the 75M apex deck.\n- Use RMB bio-vine tethering to chain infinite swings between overhead cranes in Sector 01.\n- Crouch-slide (Ctrl/C) down the 300m Velocity Canyon in Sector 02.\n- Chain bunnyhops (Space + air-strafe) along the Sector 04 Speedway for uncapped 50+ m/s speeds!\n\nSecurity hostiles are patrolling the complex. Press [R] to re-engage security waves."

[node name="CraneTerminal" parent="Terminals" instance=ExtResource("7_terminal")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 34, -280)
terminal_title = "SECTOR 01 // STRATOSPHERE OVERLOOK"
log_content = "TETHER SLINGSHOT TELEMETRY:\n--------------------------------------------------\nSuspended gantry cranes 01 through 05 provide continuous pendulum acceleration over the 200m abyss.\n\nTapping [Space] at the bottom of the pendulum arc transfers maximum kinetic momentum into forward catapult launch (+7.0 m/s impulse).\n\nStep onto the southern catapult pad to launch straight back to the Core Citadel."

[node name="SlideTerminal" parent="Terminals" instance=ExtResource("7_terminal")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 95, 62, -90)
terminal_title = "SECTOR 02 // HIGH BASTION OVERLOOK"
log_content = "VELOCITY CHUTE PROTOCOL:\n--------------------------------------------------\nWarning: Incline exceeds 30 degrees.\n\nHold [Ctrl] or [C] as you drop onto the chute. Downward momentum converts directly into hyper-velocity sliding.\n\nKeep your head low to slide beneath the security bulkheads. The final ski-jump lip at the basin will catapult you over the eastern chasm!"

[node name="SpeedwayTerminal" parent="Terminals" instance=ExtResource("7_terminal")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -165, 11, -10)
terminal_title = "SECTOR 04 // SPEEDWAY RUNWAY"
log_content = "AIR-STRAFE ACCELERATION DYNAMICS:\n--------------------------------------------------\nFriction is zero during airtime.\n\nTo build uncapped speed:\n1. Jump with [Space].\n2. Hold [A] or [D] (never W in midair).\n3. Smoothly sweep the mouse in the direction you are strafing.\n4. Jump immediately upon touching down to maintain momentum!\n\nSpeeds exceeding 60 m/s are recorded in session peaks."


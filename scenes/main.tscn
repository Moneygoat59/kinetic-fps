[node name="Terminal_Intro" parent="Entities" instance=ExtResource("6_terminal")]
transform = Transform3D(0.965926, 0, 0.258819, 0, 1, 0, -0.258819, 0, 0.965926, -6, 0, 10)
terminal_title = "VELOCITY TRIAL // BIO-KINETIC GAUNTLET"
log_content = "GAUNTLET PROTOCOLS ACTIVE:\n=========================================\nStep through the GREEN GATE to start the timer!\n\nOBSTACLES:\n1. DUCK & SLIDE CHUTE: Hold CTRL/C to crouch-slide under low barriers at 35+ m/s.\n2. BHOP S-CHASM: Bunnyhop (SPACE) across floating pillars without losing momentum.\n3. VINE CANYON: Hold RMB to vine-swing between overhead cranes; release RMB/SPACE at apex to catapult.\n4. BLAST DOOR: Shoot the 2 RED ORBS to retract the hydraulic blast gate.\n5. SUPER JUMP & SPIRE: Launch into the sky, latch onto the high spire, and slingshot to the FINISH LINE!\n\nCONTROLS: Press [R] anytime to reset to last checkpoint, or [Shift+R] for full reset."

[node name="Terminal_Finish" parent="Entities" instance=ExtResource("6_terminal")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -6, -1.0, -276)
terminal_title = "TRIAL CLEARED // SYNDICATE TELEMETRY"
log_content = "SPECTACULAR VELOCITY RUN COMPLETE.\n=========================================\nYour kinetic neural adaptations have synchronized.\nStep onto the glowing green pad ahead to return to the start line and beat your best record!\n\nRefine your bhop strafe angles and vine catapult timings to achieve sub-40 second runs."
